<script>
  /* ---------- Pine trees ---------- */
  let seed = 7;
  function rand() { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; }

  function pine(x, base, h, w) {
    let d = "";
    const tiers = 5;
    for (let i = 0; i < tiers; i++) {
      const top = base - h + i * h * 0.17;
      const bottom = top + h * 0.3;
      const half = w * (0.18 + i * 0.16);
      d += `M${x},${top} L${x + half},${bottom} L${x - half},${bottom} Z `;
    }
    d += `M${x - w * 0.05},${base - h * 0.02} h${w * 0.1} v${h * 0.06} h${-w * 0.1} Z`;
    return d;
  }

  function forest(id, count, baseMin, baseMax, hMin, hMax, avoid) {
    const g = document.getElementById(id);
    let d = "";
    for (let i = 0; i < count; i++) {
      const x = -40 + rand() * 1080;
      if (avoid && x > avoid[0] && x < avoid[1]) continue;
      const base = baseMin + rand() * (baseMax - baseMin);
      const h = hMin + rand() * (hMax - hMin);
      d += pine(x, base, h, h * 0.42);
    }
    const p = document.createElementNS("http://www.w3.org/2000/svg", "path");
    p.setAttribute("d", d);
    g.appendChild(p);
  }

  forest("pinesFar", 70, 470, 520, 160, 260);
  forest("pinesMid", 45, 580, 640, 220, 340, [380, 620]);
  forest("pinesNear", 14, 700, 720, 380, 560, [300, 700]);

  /* ---------- Rain ---------- */
  const cv = document.getElementById("rain");
  const ctx = cv.getContext("2d");
  let drops = [];
  function resize() {
    cv.width = innerWidth * devicePixelRatio;
    cv.height = innerHeight * devicePixelRatio;
    ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
    const n = Math.round(innerWidth * 0.35);
    drops = Array.from({ length: n }, () => ({
      x: Math.random() * innerWidth,
      y: Math.random() * innerHeight,
      l: 10 + Math.random() * 18,
      v: 9 + Math.random() * 8,
      o: 0.12 + Math.random() * 0.25
    }));
  }
  function rain() {
    ctx.clearRect(0, 0, innerWidth, innerHeight);
    ctx.lineWidth = 1;
    for (const d of drops) {
      ctx.strokeStyle = `rgba(190, 205, 210, ${d.o})`;
      ctx.beginPath();
      ctx.moveTo(d.x, d.y);
      ctx.lineTo(d.x - d.l * 0.18, d.y + d.l);
      ctx.stroke();
      d.y += d.v; d.x -= d.v * 0.18;
      if (d.y > innerHeight) { d.y = -20; d.x = Math.random() * (innerWidth + 100); }
    }
    requestAnimationFrame(rain);
  }
  addEventListener("resize", resize);
  resize(); rain();

  /* ---------- Quiz ---------- */
  const questions = [
    { q: "What year and month did I move to New Zealand?",
      o: ["February 2023", "March 2023", "March 2022"], a: 1 },
    { q: "What is my full name?",
      o: ["Shanice Katharina Oghenefega Herms", "Shanice Katharina Ogheneovo Herms", "Shanice Katharina Oghenetega Herms"], a: 2 },
    { q: "What is my favourite Korean food?",
      o: ["Bossam", "Samgyeopsal", "Tteokbokki"], a: 1 },
    { q: "What are my moon sign and rising sign?",
      o: ["Moon in Aries, Gemini rising", "Moon in Gemini, Aries rising", "Moon in Aries, Leo rising"], a: 0 },
    { q: "What is my brother's name?",
      o: ["Morris", "Miles", "Maurice"], a: 2 },
    { q: "Which country have I NOT been to?",
      o: ["Belgium", "Italy", "Denmark"], a: 0 },
    { q: "Who is my favourite BTS member?",
      o: ["Kim Taehyung (V)", "Min Yoongi (Suga)", "Jeon Jungkook"], a: 1 },
    { q: "Where is my first tattoo?",
      o: ["Left arm", "Right arm", "Left wrist"], a: 0 },
    { q: "What is my favourite country to travel to?",
      o: ["Vietnam", "Thailand", "Indonesia"], a: 1 },
    { q: "What is my favourite scent at the moment?",
      o: ["Lavender", "Coconut", "Lemongrass"], a: 2 }
  ];

  const PASS_MARK = 6;
  const letters = ["A", "B", "C"];
  let current = 0, score = 0, selected = null;

  function show(id) {
    ["start", "quiz", "passed", "failed", "pitch", "accepted"].forEach(s =>
      document.getElementById(s).classList.toggle("hidden", s !== id));
  }

  function startQuiz() { show("quiz"); render(); }

  function render() {
    const item = questions[current];
    selected = null;
    const btn = document.getElementById("nextBtn");
    btn.disabled = true;
    btn.textContent = current === questions.length - 1 ? "Submit" : "Next";
    document.getElementById("count").textContent = "Question " + (current + 1) + " of " + questions.length;
    document.getElementById("progress").style.width = (current / questions.length * 100) + "%";
    document.getElementById("question").textContent = item.q;
    const box = document.getElementById("options");
    box.innerHTML = "";
    item.o.forEach((text, i) => {
      const b = document.createElement("button");
      b.className = "option";
      b.innerHTML = '<span class="letter">' + letters[i] + '</span><span></span>';
      b.lastChild.textContent = text;
      b.onclick = () => {
        selected = i;
        [...box.children].forEach(c => c.classList.remove("selected"));
        b.classList.add("selected");
        btn.disabled = false;
      };
      box.appendChild(b);
    });
  }

  function next() {
    if (selected === null) return;
    if (selected === questions[current].a) score++;
    current++;
    current < questions.length ? render() : finish();
  }

  function finish() {
    const passed = score >= PASS_MARK;
    document.getElementById(passed ? "scorePass" : "scoreFail").textContent = score + "/10";
    show(passed ? "passed" : "failed");
    scrollTo({ top: 0, behavior: "smooth" });
  }

  /* ---------- Last-chance pitch ---------- */
  let timeLeft = 300, sentStep = false, timerId = null;

  function startPitch() {
    show("pitch");
    scrollTo({ top: 0, behavior: "smooth" });
    document.getElementById("pitchText").focus();
    tick();
    timerId = setInterval(tick, 1000);
  }

  function tick() {
    const t = document.getElementById("timer");
    const m = Math.floor(timeLeft / 60), s = timeLeft % 60;
    t.textContent = m + ":" + String(s).padStart(2, "0");
    t.classList.toggle("low", timeLeft <= 60);
    if (timeLeft <= 0) {
      clearInterval(timerId);
      t.textContent = "Time's up";
      document.getElementById("pitchText").readOnly = true;
      document.getElementById("sendBtn").disabled = false;
      document.getElementById("pitchNote").textContent = "Pens down. Send your pitch to Shanice first, then you will see her verdict.";
      return;
    }
    timeLeft--;
  }

  function showAccepted() {
    const slot = document.getElementById("couchSlot");
    if (!slot.firstChild) slot.appendChild(document.getElementById("couchArt").cloneNode(true));
    show("accepted");
    scrollTo({ top: 0, behavior: "smooth" });
  }

  async function sendPitch() {
    const box = document.getElementById("pitchText");
    const note = document.getElementById("pitchNote");
    const btn = document.getElementById("sendBtn");
    if (sentStep) { showAccepted(); return; }
    if (!box.value.trim()) { note.textContent = "You can't send an empty pitch! Send Shanice something anyway."; }
    const text = "My pitch for the weekend:\n\n" + (box.value.trim() || "(I ran out of time...)");
    try {
      if (navigator.share) {
        await navigator.share({ text });
        showAccepted();
        return;
      }
    } catch (e) { /* share cancelled, fall back to copy */ }
    try {
      await navigator.clipboard.writeText(text);
      note.textContent = "Copied! Paste it in a message to Shanice first, then tap the button.";
    } catch (e) {
      box.readOnly = false;
      box.select();
      note.textContent = "Copy your pitch and send it to Shanice first, then tap the button.";
    }
    sentStep = true;
    btn.textContent = "I've sent it to Shanice";
  }
</script>
</body>
