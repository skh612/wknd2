<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Saturday Exam</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #efe6d8;
    --muted: #a9b4ad;
    --amber: #e8b064;
    --amber-soft: rgba(232, 176, 100, 0.16);
    --glass: rgba(16, 24, 25, 0.68);
    --line: rgba(239, 230, 216, 0.14);
    --good: #9fd4a8;
    --bad: #e8857a;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; }
  body {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--ink);
    background: #0f1617;
    overflow-x: hidden;
  }

  /* ---------- Scene ---------- */
  .scene { position: fixed; inset: 0; z-index: 0; }
  .scene svg { width: 100%; height: 100%; display: block; }
  #rain { position: fixed; inset: 0; z-index: 1; pointer-events: none; }
  .fog { animation: drift 40s linear infinite alternate; }
  .fog.slow { animation-duration: 70s; }
  @keyframes drift { from { transform: translateX(-60px); } to { transform: translateX(60px); } }
  .flicker { animation: flicker 3.2s infinite; }
  @keyframes flicker {
    0%, 100% { opacity: 1; } 42% { opacity: .82; } 45% { opacity: .95; }
    60% { opacity: .78; } 63% { opacity: 1; }
  }

  /* ---------- Card ---------- */
  .wrap {
    position: relative; z-index: 2;
    min-height: 100%;
    display: flex; justify-content: center; align-items: flex-start;
    padding: 7vh 16px 40vh;
  }
  .card {
    width: 100%; max-width: 480px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 30px 26px;
    box-shadow: 0 20px 60px rgba(0,0,0,.45);
  }
  h1 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 600; font-size: 2.4rem; line-height: 1.1;
    margin: 0 0 14px; color: var(--ink);
  }
  .intro { color: #d9d2c5; line-height: 1.7; margin: 0 0 24px; font-size: 1rem; }
  .intro strong { color: var(--amber); font-weight: 600; }
  .eyebrow {
    font-size: .75rem; letter-spacing: .18em; text-transform: uppercase;
    color: var(--amber); margin-bottom: 10px;
  }

  .progress-wrap { height: 4px; background: var(--line); border-radius: 99px; overflow: hidden; margin-bottom: 18px; }
  .progress { height: 100%; width: 0; background: var(--amber); transition: width .4s; }
  .count { font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .question {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.6rem; font-weight: 600; line-height: 1.25; margin: 0 0 20px;
  }
  .option {
    display: flex; gap: 12px; align-items: center;
    width: 100%; text-align: left;
    padding: 14px 16px; margin-bottom: 10px;
    font: inherit; font-size: 1rem; color: var(--ink);
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--line); border-radius: 14px;
    cursor: pointer; transition: border-color .2s, background .2s;
  }
  .option:hover { border-color: rgba(232,176,100,.5); }
  .option.selected { border-color: var(--amber); background: var(--amber-soft); }
  .letter {
    flex: none; width: 28px; height: 28px; border-radius: 50%;
    display: grid; place-items: center;
    font-size: .8rem; font-weight: 600;
    border: 1px solid var(--line); color: var(--amber);
  }
  .option.selected .letter { background: var(--amber); color: #1b1410; border-color: var(--amber); }

  .btn {
    width: 100%; margin-top: 8px; padding: 15px 22px;
    font: inherit; font-weight: 600; font-size: 1rem; letter-spacing: .02em;
    color: #1b1410; background: var(--amber);
    border: none; border-radius: 14px; cursor: pointer;
    box-shadow: 0 0 30px rgba(232,176,100,.25);
    transition: transform .15s, opacity .2s;
  }
  .btn:active { transform: scale(.98); }
  .btn:disabled { opacity: .35; cursor: not-allowed; box-shadow: none; }

  .center { text-align: center; }
  .score {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 4.5rem; font-weight: 600; margin: 4px 0 6px;
  }
  .pass { color: var(--good); }
  .fail { color: var(--bad); }
  .result-msg { color: #d9d2c5; line-height: 1.7; margin: 0; }
  .hidden { display: none; }

  /* ---------- Pass list ---------- */
  .req { text-align: left; margin: 18px 0 0; padding: 0; list-style: none; }
  .req li {
    display: flex; align-items: center; gap: 12px;
    padding: 11px 14px; margin-bottom: 8px;
    border: 1px solid var(--line); border-radius: 12px;
    background: rgba(255,255,255,0.04);
  }
  .req li::before {
    content: "✓"; flex: none; width: 24px; height: 24px; border-radius: 50%;
    display: grid; place-items: center; font-size: .8rem; font-weight: 700;
    background: var(--amber); color: #1b1410;
  }

  /* ---------- Crying illustration ---------- */
  .cry { width: 100%; max-width: 300px; margin: 6px auto 4px; display: block; }
  .tear { stroke-dasharray: 7 6; animation: flow .7s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -13; } }
  .shake { animation: sob 1.4s ease-in-out infinite; transform-box: fill-box; transform-origin: bottom; }
  .shake.b { animation-delay: .35s; }
  @keyframes sob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(2px); } }

  /* ---------- Pitch ---------- */
  .timer {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 3.4rem; font-weight: 600; color: var(--amber);
    text-align: center; margin: 4px 0 14px; letter-spacing: .04em;
  }
  .timer.low { color: var(--bad); }
  textarea {
    width: 100%; min-height: 190px; resize: vertical;
    padding: 14px 16px; font: inherit; font-size: 1rem; line-height: 1.6;
    color: var(--ink); background: rgba(255,255,255,0.05);
    border: 1px solid var(--line); border-radius: 14px; outline: none;
  }
  textarea:focus { border-color: var(--amber); }
  textarea[readonly] { opacity: .7; }
  .couch { width: 100%; max-width: 320px; margin: 6px auto 16px; display: block; border-radius: 16px; }
  .heart { animation: floatUp 3s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes floatUp { 0% { transform: translateY(6px) scale(.8); opacity: 0; } 30% { opacity: 1; } 100% { transform: translateY(-14px) scale(1.05); opacity: 0; } }
  .note { color: var(--muted); font-size: .9rem; text-align: center; margin: 12px 0 0; min-height: 1.2em; }
</style>
</head>
<body>

<!-- ===== Twilight forest scene ===== -->
